# Active provider (openai | gemini | anthropic | mistral | openrouter | custom)
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# OpenRouter / OpenAI-compatible
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Custom OpenAI-compatible provider
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=
CUSTOM_AI_BASE_URL=
